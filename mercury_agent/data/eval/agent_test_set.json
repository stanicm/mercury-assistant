{
  "metadata": {
    "name": "Mercury Agent Workflow Evaluation Test Set",
    "description": "Test cases for evaluating agent routing and tool selection accuracy",
    "version": "1.0",
    "created": "2025-11-02"
  },
  "test_cases": [
    {
      "id": "agent_001",
      "query": "Tell me about Albert Einstein",
      "expected_agent": "research",
      "expected_tool": "wikipedia_search",
      "evaluation_criteria": {
        "should_contain": ["physicist", "relativity", "Einstein"],
        "should_not_contain": ["error", "sorry", "I don't know"],
        "min_length": 100,
        "task_success": true
      }
    },
    {
      "id": "agent_002",
      "query": "What is SPH?",
      "expected_agent": "retrieve",
      "expected_tool": "nvbp_rag",
      "evaluation_criteria": {
        "should_contain": ["Smoothed Particle Hydrodynamics", "SPH", "particle"],
        "should_not_contain": ["error", "not found"],
        "min_length": 50,
        "task_success": true
      }
    },
    {
      "id": "agent_003",
      "query": "Hello, how are you?",
